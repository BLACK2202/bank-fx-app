<!DOCTYPE html>
<html lang="fr">
<head><%- include('partials/head', { title: 'Nouvelle operation' }) %></head>
<body>
  <%- include('partials/nav') %>
  <main class="page page-narrow">
    <div class="page-header">
      <div>
        <h1>Nouvelle demande de taux</h1>
        <p class="page-sub">Le taux sera lu dans le fichier du siege au moment de la validation.</p>
      </div>
      <a class="btn-ghost" href="/agence">Retour</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/agence/nouvelle" class="card-form">
      <input type="hidden" name="currency_to" value="TND" />
      <label>
        Nature du sujet
        <input type="text" name="nature_sujet" value="<%= form.nature_sujet || '' %>" placeholder="Ex : reglement fournisseur, voyage client..." required />
      </label>
      <label>
        Nom du client
        <input type="text" name="nom_client" value="<%= form.nom_client || '' %>" required />
      </label>
      <label>
        Numero de compte
        <input id="numero_compte" type="text" name="numero_compte" value="<%= form.numero_compte || '' %>" placeholder="20 chiffres" pattern="\d{20}" maxlength="20" inputmode="numeric" autocomplete="off" onpaste="return false" oncopy="return false" oncut="return false" required />
      </label>
      <label>
        Verification du numero de compte
        <input id="numero_compte_confirm" type="text" name="numero_compte_confirm" value="<%= form.numero_compte_confirm || '' %>" placeholder="Retapez le numero de compte" pattern="\d{20}" maxlength="20" inputmode="numeric" autocomplete="off" onpaste="return false" oncopy="return false" oncut="return false" required />
      </label>
      <div id="account-check-message-error" class="alert alert-error" role="alert" style="display: none; margin-bottom: 1rem;">
        Les deux numéros de compte doivent être identiques et comporter exactement 20 chiffres.
      </div>
      <div id="account-check-message-success" class="alert alert-success" role="status" style="display: none; margin-bottom: 1rem;">
        <span style="font-weight: bold; margin-right: 0.5rem;">✔</span> Numéro confirmé — les deux champs correspondent.
      </div>
      <div class="form-row">
        <label>
          Devise source
          <select name="currency_from" required>
            <option value="">Choisir...</option>
            <% devises.forEach(function(d) { %>
              <% if (d.code !== 'TND') { %>
                <option value="<%= d.code %>" <%= form.currency_from === d.code ? 'selected' : '' %>><%= d.code %> — <%= d.name %></option>
              <% } %>
            <% }); %>
          </select>
        </label>
        <label>
          Devise cible
          <input type="text" value="TND - Dinar tunisien" disabled />
        </label>
      </div>
      <div class="form-row">
        <label>
          Sens de l'operation
          <select name="sens" required>
            <option value="">Choisir...</option>
            <option value="achat" <%= form.sens === 'achat' ? 'selected' : '' %>>Achat (le client achete la devise)</option>
            <option value="vente" <%= form.sens === 'vente' ? 'selected' : '' %>>Vente (le client vend la devise)</option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label>
          Date valeur
          <input type="date" name="date_valeur" value="<%= form.date_valeur || '' %>" required />
        </label>
        <label>
          Montant
          <input type="number" step="0.01" min="0.01" name="montant" value="<%= form.montant || '' %>" required />
        </label>
      </div>
      <p class="hint">La devise cible est fixee a TND. En dessous de 10&nbsp;000 de devise source, le taux spot vers TND s'applique automatiquement, sans possibilite de negociation.</p>
      <button id="submit-button" class="btn-primary" type="submit">Obtenir le taux</button>
    </form>
  </main>

  <script>
    (function() {
      const accountField = document.getElementById('numero_compte');
      const confirmField = document.getElementById('numero_compte_confirm');
      const messageError = document.getElementById('account-check-message-error');
      const messageSuccess = document.getElementById('account-check-message-success');
      const submitButton = document.getElementById('submit-button');

      function validateAccounts() {
        const value = accountField.value.trim();
        const confirm = confirmField.value.trim();
        const isValidFormat = /^[0-9]{20}$/.test(value) && /^[0-9]{20}$/.test(confirm);
        const isMatch = value === confirm && isValidFormat;

        if (!value && !confirm) {
          messageError.style.display = 'none';
          messageSuccess.style.display = 'none';
          submitButton.disabled = false;
          return;
        }

        const errorMessage = [];
        if (!/^[0-9]{20}$/.test(value) || !/^[0-9]{20}$/.test(confirm)) {
          errorMessage.push('Le numéro doit contenir exactement 20 chiffres.');
        }
        if (value !== confirm) {
          errorMessage.push('Les deux numéros doivent correspondre.');
        }

        if (errorMessage.length > 0) {
          messageError.textContent = errorMessage.join(' ');
          messageError.style.display = 'block';
          messageSuccess.style.display = 'none';
          submitButton.disabled = true;
        } else if (isMatch) {
          messageSuccess.style.display = 'block';
          messageError.style.display = 'none';
          submitButton.disabled = false;
        } else {
          messageError.textContent = 'Vérifiez les numéros de compte.';
          messageError.style.display = 'block';
          messageSuccess.style.display = 'none';
          submitButton.disabled = true;
        }
      }

      accountField.addEventListener('input', validateAccounts);
      confirmField.addEventListener('input', validateAccounts);
      validateAccounts();
    })();
  </script>
</body>
</html>
