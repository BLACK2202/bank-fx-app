<!DOCTYPE html>
<html lang="fr">
<head><%- include('partials/head', { title: officeRole === 'back_office' ? 'Back Office - Operations validees' : 'Middle Office - Toutes les operations' }) %></head>
<body>
  <%- include('partials/nav') %>
  <main class="page page-office">
    <div class="page-header">
      <div>
        <h1><%= officeRole === 'back_office' ? 'Operations validees' : 'Toutes les operations' %></h1>
        <p class="page-sub"><%= officeRole === 'back_office' ? 'Seules les operations validees par le siege avec une reference sont visibles.' : 'Consultation de toutes les operations, quel que soit leur etat. Aucune modification n est autorisee.' %></p>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="GET" action="/office" class="card-form" style="margin-bottom: 1.5rem;">
      <div class="form-row">
        <label>
          Date debut
          <input type="date" name="start_date" value="<%= startDate %>" required />
        </label>
        <label>
          Date fin
          <input type="date" name="end_date" value="<%= endDate %>" required />
        </label>
        <label>
          Recherche
          <input type="search" name="search" value="<%= searchTerm || '' %>" placeholder="ID, reference siege, agence, client, statut..." />
        </label>
      </div>
      <div class="action-row">
        <button class="btn-primary" type="submit">Filtrer</button>
        <a class="btn-secondary" href="/office/export?start_date=<%= startDate %>&end_date=<%= endDate %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>">Telecharger Excel</a>
      </div>
    </form>

    <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr>
            <th>#</th>
            <th>Agence</th>
            <th>Client</th>
            <th>Sens</th>
            <th>Paire</th>
            <th>Montant</th>
            <th>Taux spot</th>
            <th>Taux final</th>
            <th>Montant final</th>
            <th>Etat</th>
            <th class="reference-cell">Reference siege</th>
          </tr>
        </thead>
        <tbody>
          <% if (operations.length === 0) { %>
          <tr><td colspan="11" class="empty-row">Aucune operation sur cette periode.</td></tr>
          <% } %>
          <% operations.forEach(function(op) { %>
          <% const montantFinal = op.taux_final != null ? (op.montant * op.taux_final) : null; %>
          <tr>
            <td class="mono">#<%= op.id %></td>
            <td><%= op.agence_name %></td>
            <td><%= op.nom_client %></td>
            <td><span class="tag tag-<%= op.sens %> direction-<%= op.sens %>"><%= op.sens === 'achat' ? 'Achat' : 'Vente' %></span></td>
            <td class="mono"><%= op.currency_from || op.devise %> -> TND</td>
            <td class="mono"><%= op.montant.toLocaleString('fr-FR') %> <%= op.currency_from || op.devise %></td>
            <td class="mono"><%= op.taux_spot.toFixed(4) %></td>
            <td class="mono"><%= op.taux_final != null ? op.taux_final.toFixed(4) : '—' %></td>
            <td class="mono rate-highlight direction-<%= op.sens %>"><%= montantFinal != null ? montantFinal.toLocaleString('fr-FR', { maximumFractionDigits: 2 }) + ' TND' : '—' %></td>
            <td><%= op.status %></td>
            <td class="mono reference-cell"><%= op.reference_number || '—' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>